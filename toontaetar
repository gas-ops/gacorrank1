<script>
(function(){
  const track = document.getElementById('wbTrack');
  if(!track) return;

  /* Data contoh — silakan ganti sesuai kebutuhan */
  const winners = [
    { name:'Rizky_77',   amount:'Rp 12.450.000', game:'Slot Olympus',   img:'https://i.pravatar.cc/80?img=12' },
    { name:'Bunda_Slot', amount:'Rp 8.900.000',  game:'Sweet Bonanza',  img:'https://i.pravatar.cc/80?img=32' },
    { name:'AndiGaming', amount:'Rp 21.750.000', game:'Gates of Aztec', img:'https://i.pravatar.cc/80?img=15' },
    { name:'QueenBet88', amount:'Rp 5.300.000',  game:'Mahjong Ways',   img:'https://i.pravatar.cc/80?img=45' },
    { name:'JagoanNeon', amount:'Rp 17.800.000', game:'Starlight X',    img:'https://i.pravatar.cc/80?img=8'  },
    { name:'Sultan_Ungu',amount:'Rp 30.100.000', game:'Wild Bounty',    img:'https://i.pravatar.cc/80?img=52' },
    { name:'MegaJackpot',amount:'Rp 9.650.000',  game:'Lucky Neko',     img:'https://i.pravatar.cc/80?img=23' }
  ];

  /* Render awal (dobel biar loop mulus) */
  function createItem(data){
    const li = document.createElement('li');
    li.className = 'wb-item';
    li.innerHTML = `
      <img class="wb-thumb" src="${data.img}" alt="${data.name}">
      <div>
        <p class="wb-name">${data.name}</p>
        <div class="wb-amount">${data.amount}</div>
        <div class="wb-game">${data.game}</div>
      </div>
    `;
    return li;
  }

  winners.forEach(w => track.appendChild(createItem(w)));
  winners.forEach(w => track.appendChild(createItem(w)));

  /* Auto scroll vertikal */
  let offset = 0;
  const speed = 0.35; // px per frame
  const totalHeight = () => track.scrollHeight / 2;

  function loop(){
    offset += speed;
    if(offset >= totalHeight()){
      offset = 0;
    }
    track.style.transform = `translateY(-${offset}px)`;
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);

  /* Efek "is-new" + koin neon tiap beberapa detik */
  const items = track.querySelectorAll('.wb-item');
  setInterval(() => {
    const random = items[Math.floor(Math.random() * (items.length / 2))];
    if(!random) return;

    random.classList.add('is-new');

    // spawn 3 koin neon
    for(let i=0;i<3;i++){
      const coin = document.createElement('span');
      coin.className = 'wb-coin';
      coin.style.left = (30 + Math.random()*60) + '%';
      coin.style.top  = (20 + Math.random()*40) + '%';
      coin.style.setProperty('--sx', (Math.random()*20 - 10) + 'px');
      random.appendChild(coin);
      setTimeout(()=>coin.remove(), 950);
    }

    setTimeout(()=>random.classList.remove('is-new'), 1400);
  }, 2600);
})();
</script>
