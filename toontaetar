<!-- ============ STYLE — NEON PURPLE POLKADOT DANCE ============ -->
<style>
:root{
  /* Palet ungu neon */
  --m778-void:#0b0018;
  --m778-deep:#1a0333;
  --m778-purple:#3b0a70;
  --m778-mid:#6d28d9;
  --m778-neon:#b026ff;
  --m778-neon-soft:#c77dff;
  --m778-pink:#ff2fd0;
  --m778-cyan:#7df9ff;
  --m778-lilac:#e9d5ff;

  --m778-line:rgba(176,38,255,.35);
  --m778-glass:rgba(176,38,255,.10);

  --m778-txt:#fdf8ff;
  --m778-muted:#d6b8ff;
}

/* =========================
   PANEL UTAMA
========================== */
.wb-panel{
  position:relative;
  overflow:hidden;

  width:340px;

  border:1px solid rgba(176,38,255,.55);
  border-radius:16px;

  color:var(--m778-txt);

  font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;

  background:
    radial-gradient(circle at top right, rgba(255,47,208,.22), transparent 42%),
    radial-gradient(circle at bottom left, rgba(125,249,255,.14), transparent 40%),
    linear-gradient(145deg,
      #24044a 0%,
      var(--m778-deep) 45%,
      var(--m778-void) 100%);

  box-shadow:
    0 12px 28px rgba(0,0,0,.55),
    0 0 26px rgba(176,38,255,.30),
    0 0 12px rgba(255,47,208,.18);

  animation:m778PanelGlow 3.6s ease-in-out infinite;
}

/* garis neon atas */
.wb-panel::before{
  content:"";
  position:absolute;
  top:0; left:0; right:0;
  height:2px;

  background:linear-gradient(90deg,
    transparent,
    #6d28d9,
    #b026ff,
    #ff2fd0,
    #ffffff,
    #ff2fd0,
    #b026ff,
    #6d28d9,
    transparent);

  box-shadow:0 0 12px rgba(176,38,255,.75);
  z-index:5;

  animation:m778LinePulse 2.6s ease-in-out infinite;
}

/* ---- POLKADOT BERDANSA ---- */
.wb-dots{
  position:absolute;
  inset:-40%;

  background-image:
    radial-gradient(circle, rgba(255,47,208,.85) 2.6px, transparent 3.2px),
    radial-gradient(circle, rgba(199,125,255,.70) 1.8px, transparent 2.4px),
    radial-gradient(circle, rgba(125,249,255,.55) 1.4px, transparent 2px);

  background-size:44px 44px, 68px 68px, 92px 92px;
  background-position:0 0, 22px 32px, 44px 10px;

  opacity:.28;
  mix-blend-mode:screen;
  pointer-events:none;
  z-index:0;

  animation:m778DotsDance 9s linear infinite;
}

/* ---- SHINE NEON ---- */
.wb-shine{
  position:absolute;
  top:-50%; left:-45%;
  width:32%; height:200%;

  background:linear-gradient(90deg,
    transparent,
    rgba(176,38,255,.20),
    rgba(255,255,255,.55),
    rgba(255,47,208,.28),
    transparent);

  transform:skewX(-20deg);
  pointer-events:none;
  z-index:1;

  animation:m778ShineMove 5.5s linear infinite;
}

/* Semua child naik di atas polkadot */
.wb-panel > .wb-head,
.wb-panel > .wb-list-wrap,
.wb-panel > .wb-foot{
  position:relative;
  z-index:3;
}

/* =========================
   HEADER
========================== */
.wb-head{
  display:flex;
  align-items:center;
  gap:10px;

  padding:10px 12px;

  border-bottom:1px solid var(--m778-line);

  background:
    radial-gradient(120% 140% at 0% 0%,
      rgba(255,47,208,.22),
      transparent 45%),
    linear-gradient(90deg,
      rgba(109,40,217,.22),
      rgba(255,47,208,.05));
}

/* TROPHY */
.wb-trophy{
  width:22px;
  height:22px;
  flex:0 0 22px;

  color:#2a0550;

  background:linear-gradient(135deg,
    #ffe0ff 0%,
    #ff2fd0 35%,
    #b026ff 65%,
    #6d28d9 100%);

  border:1px solid rgba(255,224,255,.75);
  border-radius:7px;

  display:grid;
  place-items:center;

  box-shadow:
    0 6px 14px rgba(0,0,0,.35),
    0 0 14px rgba(255,47,208,.55);

  animation:m778AvatarDance 3.4s ease-in-out infinite;
}

.wb-title{
  font:900 13px/1.1 system-ui;
  letter-spacing:.4px;
  text-transform:uppercase;

  color:#ffffff;

  text-shadow:
    0 1px 2px rgba(0,0,0,.7),
    0 0 10px rgba(176,38,255,.55);
}

/* STATUS DOT */
.wb-dot{
  margin-left:auto;

  width:9px;
  height:9px;

  border-radius:50%;

  background:radial-gradient(circle,
    #ffd9ff 0%,
    #ff2fd0 45%,
    #b026ff 100%);

  box-shadow:
    0 0 6px #ff2fd0,
    0 0 14px rgba(176,38,255,.85);

  animation:m778Ping 1.8s ease-in-out infinite;
}

@keyframes m778Ping{
  0%,100%{
    transform:scale(1);
    box-shadow:
      0 0 6px #ff2fd0,
      0 0 12px rgba(176,38,255,.65);
  }
  50%{
    transform:scale(1.35);
    box-shadow:
      0 0 10px #ff9dfb,
      0 0 22px rgba(255,47,208,1);
  }
}

/* =========================
   LIST WRAPPER
========================== */
.wb-list-wrap{
  height:280px;
  overflow:hidden;
  position:relative;

  -webkit-mask-image:linear-gradient(to bottom,
    transparent 0, #000 8%, #000 92%, transparent 100%);
  mask-image:linear-gradient(to bottom,
    transparent 0, #000 8%, #000 92%, transparent 100%);

  background:linear-gradient(180deg,
    rgba(176,38,255,.10),
    rgba(11,0,24,.05));
}

.wb-track{
  list-style:none;
  margin:0;
  padding:8px 10px 10px;

  display:flex;
  flex-direction:column;
  gap:10px;

  will-change:transform;
}

/* =========================
   ITEM
========================== */
.wb-item{
  display:grid;
  grid-template-columns:52px 1fr;
  gap:10px;

  padding:8px;

  border-radius:12px;
  position:relative;
  isolation:isolate;

  border:1px solid rgba(176,38,255,.35);

  background:linear-gradient(135deg,
    rgba(109,40,217,.55),
    rgba(26,3,51,.85));

  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.03),
    0 4px 10px rgba(0,0,0,.25);

  transition:transform .25s ease, border-color .25s ease, box-shadow .25s ease;
}

.wb-item:hover{
  transform:translateY(-2px) rotate(-.3deg);
  border-color:rgba(255,47,208,.75);

  box-shadow:
    0 8px 20px rgba(0,0,0,.42),
    0 0 14px rgba(176,38,255,.35),
    0 0 10px rgba(255,47,208,.22);
}

/* =========================
   THUMBNAIL
========================== */
.wb-thumb{
  width:52px;
  height:52px;

  border-radius:10px;
  object-fit:cover;
  display:block;

  border:1px solid rgba(255,47,208,.55);

  box-shadow:
    0 4px 10px rgba(0,0,0,.40),
    0 0 10px rgba(176,38,255,.35);
}

/* =========================
   TEXT
========================== */
.wb-name{
  font:800 12px/1.1 system-ui;
  letter-spacing:.2px;
  margin:0 0 4px;
  color:#ffffff;
  text-shadow:0 0 8px rgba(176,38,255,.45);
}

.wb-amount{
  font:900 13px/1 system-ui;

  background:linear-gradient(90deg,
    #b026ff 0%,
    #ff2fd0 45%,
    #ffffff 55%,
    #ff2fd0 65%,
    #b026ff 100%);
  background-size:200% auto;

  -webkit-background-clip:text;
  background-clip:text;
  -webkit-text-fill-color:transparent;

  filter:drop-shadow(0 0 5px rgba(255,47,208,.55));

  animation:m778TitleShine 4s linear infinite;
}

.wb-game{
  font:600 11px/1.2 system-ui;
  color:var(--m778-muted);
  margin-top:4px;
  opacity:.95;
}

/* =========================
   ITEM BARU
========================== */
.wb-item.is-new{
  border-color:rgba(255,47,208,.75);

  background:linear-gradient(135deg,
    rgba(140,50,255,.70),
    rgba(26,3,51,.92));

  box-shadow:
    0 14px 26px rgba(0,0,0,.55),
    0 0 22px rgba(176,38,255,.40),
    0 0 14px rgba(255,47,208,.25),
    inset 0 0 0 1px rgba(255,47,208,.10);

  transform:translateZ(0);
  animation:m778Pulse 1.2s ease both;
}

@keyframes m778Pulse{
  0%{ filter:saturate(1); }
  40%{ filter:saturate(1.3) brightness(1.10); }
  100%{ filter:saturate(1.10); }
}

/* =========================
   COIN / SPARK NEON
========================== */
.wb-coin{
  position:absolute;
  width:12px;
  height:12px;
  border-radius:50%;

  background:radial-gradient(circle at 30% 30%,
    #ffffff 0%,
    #ffd9ff 18%,
    #ff2fd0 48%,
    #b026ff 72%,
    #4c1090 100%);

  border:1px solid rgba(255,224,255,.65);

  box-shadow:
    0 0 8px rgba(255,47,208,.85),
    0 0 16px rgba(176,38,255,.55);

  pointer-events:none;
  z-index:5;

  animation:coinPop .9s ease-out forwards;
}

@keyframes coinPop{
  0%{
    transform:translate(var(--sx,0),14px) scale(.6) rotate(0);
    opacity:.95;
  }
  70%{
    transform:translate(calc(var(--sx,0)*1.2),-20px) scale(1) rotate(120deg);
    opacity:1;
  }
  100%{
    transform:translate(calc(var(--sx,0)*2),-36px) scale(.85) rotate(240deg);
    opacity:0;
  }
}

/* =========================
   FOOTER
========================== */
.wb-foot{
  border-top:1px solid var(--m778-line);
  padding:8px 10px;

  font:600 11px/1.2 system-ui;
  color:#e6d5ff;

  display:flex;
  gap:8px;
  align-items:center;

  background:linear-gradient(90deg,
    rgba(109,40,217,.22),
    rgba(255,47,208,.05));
}

/* =========================
   PILL
========================== */
.wb-pill{
  margin-left:auto;

  border:1px solid #ffb8f0;
  color:#1a0333;

  background:linear-gradient(135deg,
    #ffd9ff 0%,
    #ff2fd0 30%,
    #b026ff 65%,
    #6d28d9 100%);

  border-radius:999px;
  font:800 10px/1 system-ui;
  padding:6px 10px;

  box-shadow:
    0 6px 14px rgba(0,0,0,.35),
    0 0 12px rgba(255,47,208,.45);

  text-shadow:0 1px 0 rgba(255,255,255,.35);

  animation:m778PillGlow 2.4s ease-in-out infinite;
}

@keyframes m778PillGlow{
  0%,100%{
    box-shadow:
      0 6px 14px rgba(0,0,0,.35),
      0 0 10px rgba(255,47,208,.40);
  }
  50%{
    box-shadow:
      0 6px 14px rgba(0,0,0,.35),
      0 0 20px rgba(255,47,208,.85),
      0 0 32px rgba(176,38,255,.55);
  }
}

/* =========================
   ANIMASI GLOBAL
========================== */
@keyframes m778DotsDance{
  0%{
    background-position:0 0, 22px 32px, 44px 10px;
    transform:rotate(0deg) scale(1.04);
  }
  25%{ transform:rotate(2.5deg) scale(1.09); }
  50%{
    background-position:44px 44px, -12px -12px, 0 58px;
    transform:rotate(0deg) scale(1.04);
  }
  75%{ transform:rotate(-2.5deg) scale(1.09); }
  100%{
    background-position:88px 88px, 10px 58px, 44px 104px;
    transform:rotate(0deg) scale(1.04);
  }
}

@keyframes m778ShineMove{
  0%{ left:-50%; }
  100%{ left:135%; }
}

@keyframes m778PanelGlow{
  0%,100%{
    box-shadow:
      0 12px 28px rgba(0,0,0,.55),
      0 0 22px rgba(176,38,255,.25),
      0 0 10px rgba(255,47,208,.15);
  }
  50%{
    box-shadow:
      0 12px 28px rgba(0,0,0,.55),
      0 0 34px rgba(255,47,208,.55),
      0 0 16px rgba(125,249,255,.25);
  }
}

@keyframes m778LinePulse{
  0%,100%{ opacity:.65; transform:scaleX(.9); }
  50%{ opacity:1; transform:scaleX(1); }
}

@keyframes m778TitleShine{
  0%{ background-position:200% center; }
  100%{ background-position:-200% center; }
}

@keyframes m778AvatarDance{
  0%,100%{ transform:translateY(0) rotate(0deg); }
  30%{ transform:translateY(-3px) rotate(-5deg); }
  60%{ transform:translateY(-3px) rotate(5deg); }
}

/* =========================
