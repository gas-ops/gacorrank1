    .button-login-daftar {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
        font-weight: 700;
    }

    .button-login-daftar a {
        text-align: center;
        text-decoration: none;
        display: block;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .login,
    .register {
        color: #ffffff;
        padding: 15px 10px;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-shadow:
            0 1px 2px rgba(0, 0, 0, 0.8),
            0 0 8px rgba(255, 215, 0, 0.45);
    }

    .login,
    .login-button,
    .register,
    .register-button {
        background: linear-gradient(
            135deg,
            #001b4d 0%,
            #003b8f 20%,
            #0066ff 45%,
            #0047b3 65%,
            #d4a900 82%,
            #ffd700 100%
        );

        background-size: 250% 250%;

        border: 2px solid #ffd700;

        box-shadow:
            0 0 6px rgba(0, 102, 255, 0.8),
            0 0 12px rgba(255, 215, 0, 0.55),
            inset 0 0 10px rgba(255, 255, 255, 0.15);

        animation:
            MADRID778-gradient 4s ease infinite,
            MADRID778-blink 1.5s ease-in-out infinite;
    }

    /* Animasi pergerakan gradasi */
    @keyframes MADRID778-gradient {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* Animasi blink / glow */
    @keyframes MADRID778-blink {
        0%,
        100% {
            border-color: #ffd700;
            box-shadow:
                0 0 5px rgba(0, 102, 255, 0.8),
                0 0 8px rgba(255, 215, 0, 0.45),
                inset 0 0 8px rgba(255, 255, 255, 0.10);
        }

        50% {
            border-color: #fff3a0;
            box-shadow:
                0 0 10px #0077ff,
                0 0 18px rgba(0, 119, 255, 0.85),
                0 0 25px rgba(255, 215, 0, 0.9),
                inset 0 0 12px rgba(255, 215, 0, 0.25);
        }
    }

    /* Efek saat disentuh / hover */
    .button-login-daftar a:hover {
        transform: translateY(-2px) scale(1.02);
